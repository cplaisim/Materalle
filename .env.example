# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Database (PostgreSQL)
DB_NAME=materalle_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Backend — "anthropic" or "ollama"
LLM_BACKEND=ollama
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Ollama (used when LLM_BACKEND=ollama)
# Docker: http://ollama:12434 | Local: http://localhost:12434
OLLAMA_BASE_URL=http://ollama:12434
OLLAMA_MODEL=llama3

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
